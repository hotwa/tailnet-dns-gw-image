# Official latest non-prerelease GitHub releases are resolved to immutable
# Docker manifest digests before build. Minimums prevent accidental downgrade.
PIPELINE_EPOCH=v1
TAILSCALE_REPOSITORY=tailscale/tailscale
TAILSCALE_IMAGE=docker.io/tailscale/tailscale
TAILSCALE_MIN_VERSION=1.102.2
ADGUARDHOME_REPOSITORY=AdguardTeam/AdGuardHome
ADGUARDHOME_IMAGE=docker.io/adguard/adguardhome
ADGUARDHOME_MIN_VERSION=0.107.78
IMAGE_NAME=tailnet-dns-gw
